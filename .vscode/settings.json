{
    "deno.enable": true,
    "deno.enablePaths": ["./supabase/functions"],
    "vscode-autoGit.enabled": true,
    "vscode-autoGit.syncAfterCommit": false,
    "vscode-autoGit.syncOnStartup": false,
    "vscode-autoGit.syncInterval": 10,
    "vscode-autoGit.debounceIntervalSeconds": 30,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "attendance-phone.html": "attendance-app.webmanifest, attendance-phone-sw.js",
        "package.json": "package-lock.json"
    },
    "files.exclude": {
        "**/node_modules": true,
        "**/.git": true,
        "**/AGENTS.md": true,
        "**/.vscode": true,
        "supabase/.temp": true,
        "Documentations/Review Backups": true,
        "Documentations/Review Evidence": true,
        "Documentations/Review Previews": true,
        "Documentations/Review Notes": true,
        "Documentations/Tools": true,
        "Documentations/Chapter 3 Diagrams/_Archive": true,
        "Documentations/Chapter 3 Diagrams/_Sources": true,
        "Documentations/Prototype Screenshots/Originals": true,
        "Documentations/Prototype Screenshots/Updated FEATURES": true,
        "Documentations/Prototype Screenshots/_Sources": true,
        "Documentations/Chapter 1.docx": true,
        "Documentations/Chapter 2.docx": true,
        "Documentations/Chapter 3.docx": true,
        "Documentations/Chapters 1-3 - DFD explanation corrected.docx": true,
        "Documentations/Chapters 1-3 - Reviewed and corrected.docx": true,
        "Documentations/Chapters 1-3 Final Consistency Revision.docx": true,
        "Documentations/IronGrind – Chapters 1–3 – Draft for Adviser Review.docx": true
    }
}
